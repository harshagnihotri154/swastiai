{
  "version": 2,
  "buildCommand": "cd apps/backend && npm run build && cd ../frontend && npm install && npm run build",
  "outputDirectory": "apps/frontend/dist",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "/api"
    },
    {
      "source": "/webhook",
      "destination": "/api"
    },
    {
      "source": "/privacy",
      "destination": "/api"
    }
  ]
}
